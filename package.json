{
  "name": "jaysociety-intel",
  "version": "0.1.0",
  "private": true,
  "description": "Jay Society Creator Intelligence: private trend research, creator intelligence and content idea engine",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "if [ \"$APP_ROLE\" = \"worker\" ]; then tsx src/worker/index.ts; else tsx scripts/migrate.ts && next start -p ${PORT:-3000}; fi",
    "worker": "tsx src/worker/index.ts",
    "migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vapid": "web-push generate-vapid-keys"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.12.1",
    "jose": "^6.2.18",
    "next": "^15.5.29",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "vitest": "^5.1.1"
  }
}

# Required
DATABASE_URL=postgresql://...            # Railway Postgres: ${{Postgres.DATABASE_URL}}
SESSION_SECRET=                          # 32+ random chars: openssl rand -base64 48
APP_PASSWORD=                            # or APP_PASSWORD_HASH (bcrypt) instead
APP_URL=https://your-app.up.railway.app  # used for OAuth redirects

# Free data sources
YOUTUBE_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Your own analytics (OAuth, free)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=                    # optional; falls back to SESSION_SECRET

# Push notifications (npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional, paid (capped in Settings)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
AI_MONTHLY_CAP_USD=2
